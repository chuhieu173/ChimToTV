<?xml version="1.0" encoding="utf-8"?>
<!-- Trình phát truyền hình (LiveActivity): hình toàn màn hình, thanh trên / dưới tự ẩn, bảng kênh bên phải (☰ Kênh),
     thẻ đài radio thay cho hình, màn chờ / lỗi ở giữa. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.media3.ui.PlayerView
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                app:shutter_background_color="@android:color/black"
                app:surface_type="surface_view"
                app:use_controller="false" />

            <!-- Thẻ đài radio: logo / 📻, tên đài, ♪ bài đang phát, MP3 · kbps -->
            <LinearLayout
                android:id="@+id/radioCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="60dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_logo_box">

                    <TextView
                        android:id="@+id/radioIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📻"
                        android:textSize="72sp" />

                    <ImageView
                        android:id="@+id/radioLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:id="@+id/radioName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/radioSong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="40dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/brand"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/radioInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Thanh trên: tên kênh · chương trình, nhãn TRỰC TIẾP / CHẬM / TẠM DỪNG -->
            <LinearLayout
                android:id="@+id/top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/bg_osd_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingTop="16dp"
                android:paddingEnd="28dp"
                android:paddingBottom="36dp">

                <TextView
                    android:id="@+id/num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:textColor="@color/text_dim"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_live_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/text_dim"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Thanh dưới: chương trình đang phát, giờ, thanh tiến độ, nút -->
            <LinearLayout
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_osd"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="40dp"
                android:paddingEnd="28dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/prog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:ellipsize="end"
                        android:maxWidth="420dp"
                        android:singleLine="true"
                        android:textColor="@color/text_dim"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_osd" />

                <LinearLayout
                    android:id="@+id/buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnChannels"
                        style="@style/TvButton"
                        android:text="☰ Kênh" />

                    <TextView
                        android:id="@+id/btnPrev"
                        style="@style/TvButton"
                        android:text="« Kênh trước" />

                    <TextView
                        android:id="@+id/btnPlay"
                        style="@style/TvButton"
                        android:text="Tạm dừng" />

                    <TextView
                        android:id="@+id/btnNext"
                        style="@style/TvButton"
                        android:text="Kênh sau »" />

                    <TextView
                        android:id="@+id/btnLive"
                        style="@style/TvButton"
                        android:text="Về trực tiếp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnSource"
                        style="@style/TvButton"
                        android:text="Nguồn 1/1"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnGuide"
                        style="@style/TvButton"
                        android:text="Lịch" />

                    <TextView
                        android:id="@+id/btnFav"
                        style="@style/TvButton"
                        android:text="☆" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnClose"
                        style="@style/TvButton"
                        android:layout_marginEnd="0dp"
                        android:text="✕ Đóng" />
                </LinearLayout>
            </LinearLayout>

            <!-- Đang mở / lỗi -->
            <LinearLayout
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="40dp">

                <ProgressBar
                    android:id="@+id/spinner"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:indeterminateTint="@color/focus" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:maxWidth="640dp"
                    android:shadowColor="#000000"
                    android:shadowRadius="6"
                    android:textColor="@color/text"
                    android:textSize="19sp" />

                <LinearLayout
                    android:id="@+id/statusButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnRetry"
                        style="@style/TvButton"
                        android:text="Thử lại" />

                    <TextView
                        android:id="@+id/btnSkip"
                        style="@style/TvButton"
                        android:text="Kênh sau »" />

                    <TextView
                        android:id="@+id/btnBack"
                        style="@style/TvButton"
                        android:layout_marginEnd="0dp"
                        android:text="Quay lại" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gõ số kênh bằng remote -->
            <TextView
                android:id="@+id/digits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="80dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_osd_notice"
                android:paddingStart="22dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:paddingBottom="8dp"
                android:textColor="@color/focus"
                android:textSize="44sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="90dp"
                android:background="@drawable/bg_osd_notice"
                android:maxWidth="640dp"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bảng kênh (☰ Kênh): hình thu vào phần còn lại, không bị che -->
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingBottom="12dp"
                android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
